# Terraform Variables Template for Platform Orchestrator Tutorial
# Copy this file to terraform.tfvars and fill in your values

# =============================================================================
# REQUIRED: Platform Orchestrator Configuration
# =============================================================================

# Your Platform Orchestrator organization ID
orchestrator_org = "your-org-id"

# Your Platform Orchestrator service-user API token
orchestrator_auth_token = "your-api-token-here"

# =============================================================================
# AWS Configuration (OPTIONAL - only needed if AWS is in enabled_cloud_providers)
# =============================================================================

# AWS region for resources (has default value)
# aws_region = "eu-north-1"

# =============================================================================
# GCP Configuration (OPTIONAL - only needed if GCP is in enabled_cloud_providers)
# =============================================================================

# GCP project ID (has default value, override for actual use)
# gcp_project_id = "your-gcp-project-id"

# GCP region for resources (has default value)
# gcp_region = "europe-west3"

# GCP zone for resources (has default value)
# gcp_zone = "europe-west3-a"

# =============================================================================
# Azure Configuration (OPTIONAL - only needed if Azure is in enabled_cloud_providers)
# =============================================================================

# Azure subscription ID (has default value, override for actual use)
# azure_subscription_id = "your-azure-subscription-id"

# Azure tenant ID (has default value, override for actual use)
# azure_tenant_id = "your-azure-tenant-id"

# Azure region/location for resources (has default value)
# azure_location = "West Europe"

# =============================================================================
# OPTIONAL: Resource Naming
# =============================================================================

# Prefix for resource names (auto-generated if not specified)
# This helps identify resources and avoid naming conflicts
# prefix = "tutorial"

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to terraform.tfvars:
#    cp terraform.tfvars.template terraform.tfvars
#
# 2. Edit terraform.tfvars with your actual values
#
# 3. Ensure you have the required cloud provider credentials:
#    - AWS: Configure AWS CLI or set environment variables
#    - GCP: Set GOOGLE_APPLICATION_CREDENTIALS or use gcloud auth
#    - Azure: Use az login or set environment variables
#
# 4. Get your Platform Orchestrator API token:
#    - Create a service-user token with appropriate permissions in your installation
#
# 5. Initialize and apply:
#    terraform init
#    terraform plan
#    terraform apply
